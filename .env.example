# Supabase Project Configuration
# Use modern Publishable / Secret keys (or legacy ANON / SERVICE_ROLE equivalents)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_ and NEVER commit real keys
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Signing secret for HttpOnly participant & presenter session cookies (32+ random chars)
SESSION_SECRET=replace_with_at_least_32_random_hex_or_base64_characters

# Shared PIN entered by participating teachers on /join
WORKSHOP_PIN=202604

# Separate private facilitator passcode for /presenter (NEVER share with participants)
FACILITATOR_PASSCODE=replace_with_strong_facilitator_passcode

# Public URL used for QR code generation (optional; defaults to request origin / VERCEL_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default seeded workshop slug
WORKSHOP_SLUG=mediouna-ai-teacher-lab
